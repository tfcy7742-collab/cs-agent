# ===========================================================================
# 长会话客服 Agent —— 环境变量
#
# 用法：copy .env.example .env 后按需修改。
# 所有项都有默认值；不填 Key 时进入**离线模板模式**（接口与流式协议不变，
# 仅应答改为本地模板），便于离线演示与 CI。
# ===========================================================================

# ============================== LLM ==============================
# auto（有 Key 就联网）| online（强制联网）| offline（强制离线，CI 用）
LLM_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ============================== 会话 ==============================
# 工作记忆里保留的最近原文轮数（1 轮 = 一问一答）
WORKING_RECENT_TURNS=8
# 历史超过该字符数时触发滚动摘要（P2）
HISTORY_COMPRESS_CHARS=6000
# 单条消息最大长度
MAX_MESSAGE_CHARS=4000

# =============================== 服务 ==============================
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ============================== 存储 ==============================
DB_PATH=./data/cs_agent.db
